generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Confession {
  id        Int      @id @default(autoincrement())
  crushName String
  message   String
  createdAt DateTime @default(now())
  replies   Reply[]
}

model Reply {
  id           Int        @id @default(autoincrement())
  message      String
  createdAt    DateTime   @default(now())
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  confessionId Int
}
