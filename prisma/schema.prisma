generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Confession {
  id             Int      @id @default(autoincrement())
  crushName      String
  message        String
  senderNickname String?
  gifUrl         String?
  guessEnabled   Boolean  @default(false)
  relateCount    Int      @default(0)
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now())
  replies        Reply[]
}

model Reply {
  id             Int        @id @default(autoincrement())
  message        String
  senderNickname String?
  gifUrl         String?
  createdAt      DateTime   @default(now())
  confession     Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  confessionId   Int
}

model Visit {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// A single row per admin broadcast. There's no "active" flag or expiry
// column — freshness is just "was this created recently enough that a
// currently-browsing visitor should still see it" (see
// ANNOUNCEMENT_FRESH_WINDOW_MS in lib/announcer.ts), computed at query
// time in /api/announcements/latest. Nothing here represents an
// ongoing/persistent banner; it's a one-shot popup, not a page fixture.
model Announcement {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

model BackgroundMusic {
  id        Int      @id @default(1)
  fileName  String
  mimeType  String
  data      String
  // Playback loudness, admin-adjustable from the Music tab. 1.0 = the
  // track's normal, unmodified volume. Values above 1.0 are a genuine
  // boost past what a plain <audio> element can do (its native volume
  // caps at 1.0) — the player applies extra gain via the Web Audio API
  // to go louder than "normal max". Capped at 3.0 (300%) to avoid ugly
  // clipping/distortion at extreme boosts.
  volume    Float    @default(0.22)
  updatedAt DateTime @updatedAt
}

// Single row (id is always 1, like BackgroundMusic above) holding the
// site-wide "closed" switch. Reads go through lib/siteSettings.ts, which
// wraps this in Next's Data Cache with no time-based expiry — the table
// is only actually queried right after an admin flips the switch (the
// write calls revalidateTag), not on every visitor request. That keeps
// the shutdown check from adding any per-request database compute or
// network round trip.
model SiteSettings {
  id              Int      @id @default(1)
  shutdown        Boolean  @default(false)
  shutdownMessage String   @default("we're taking a quick break. back soon.")
  updatedAt       DateTime @updatedAt
}

// One row per active browser session, used only to answer "how many
// people are on the site right now". Each open tab pings /api/presence
// every ~20s to bump lastSeen; a session counts as "live" while lastSeen
// is recent (see PRESENCE_WINDOW_MS in lib/presence.ts). Rows are deleted
// as soon as a tab closes (best-effort beacon) or, failing that, once
// they go stale — so this table never accumulates history and is not a
// visit log (Visit above already covers total visits).
model Presence {
  sessionKey String   @id
  lastSeen   DateTime @default(now())
}

// Admin-added extra words to block, on top of the built-in default list in
// lib/wordFilter.ts. Kept separate from the defaults so the safety-net
// words are never accidentally deleted from the admin UI — this table is
// purely the "extra words you typed in yourself" list.
model BannedWord {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  createdAt DateTime @default(now())
}
