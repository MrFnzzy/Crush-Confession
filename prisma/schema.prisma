generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Confession {
  id             Int      @id @default(autoincrement())
  crushName      String
  message        String
  senderNickname String?
  gifUrl         String?
  guessEnabled   Boolean  @default(false)
  relateCount    Int      @default(0)
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now())
  replies        Reply[]
  pushSubscriptions ConfessionPushSubscription[]
}

// Web Push subscription for "notify me when someone replies" on one
// specific confession. Tied to a browser/device (the `endpoint`), not an
// account — same anonymous-trace idea as the relate/guess localStorage
// tracking already used on the wall, just backed by a real row so the
// server can reach the device later. The same endpoint can subscribe to
// several different confessions (one row each); re-subscribing to the
// same confession from the same browser upserts rather than duplicating.
model ConfessionPushSubscription {
  id           Int        @id @default(autoincrement())
  endpoint     String
  p256dh       String
  auth         String
  createdAt    DateTime   @default(now())
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  confessionId Int

  @@unique([confessionId, endpoint])
}

model Reply {
  id             Int        @id @default(autoincrement())
  message        String
  senderNickname String?
  gifUrl         String?
  createdAt      DateTime   @default(now())
  confession     Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  confessionId   Int
}

model Visit {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// A single row per admin broadcast. There's no "active" flag or expiry
// column — freshness is just "was this created recently enough that a
// currently-browsing visitor should still see it" (see
// ANNOUNCEMENT_FRESH_WINDOW_MS in lib/announcer.ts), computed at query
// time in /api/announcements/latest. Nothing here represents an
// ongoing/persistent banner; it's a one-shot popup, not a page fixture.
model Announcement {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

// Single row (id is always 1) holding the whole-playlist volume — one
// loudness setting applies to every track, not per-track, to keep the
// admin UI simple. The actual tracks live in BackgroundMusicTrack below;
// this row can exist with zero tracks (playlist just empty).
model BackgroundMusic {
  id        Int                    @id @default(1)
  // Playback loudness, admin-adjustable from the Music tab. 1.0 = the
  // track's normal, unmodified volume. Values above 1.0 are a genuine
  // boost past what a plain <audio> element can do (its native volume
  // caps at 1.0) — the player applies extra gain via the Web Audio API
  // to go louder than "normal max". Capped at 3.0 (300%) to avoid ugly
  // clipping/distortion at extreme boosts.
  volume    Float                  @default(0.22)
  updatedAt DateTime               @updatedAt
  tracks    BackgroundMusicTrack[]
}

// One row per uploaded playlist track (max 10, enforced in the API route).
// `order` is just upload order (0, 1, 2...) and decides playback order;
// there's no reordering UI, only add/remove. Once uploaded a track's
// bytes never change in place — removing and re-adding is how you'd
// "replace" one — so /api/music/file/[id] can cache each track's bytes
// forever keyed on its id alone, no version query param needed.
model BackgroundMusicTrack {
  id                Int             @id @default(autoincrement())
  fileName          String
  mimeType          String
  data              String
  order             Int             @default(0)
  createdAt         DateTime        @default(now())
  backgroundMusic   BackgroundMusic @relation(fields: [backgroundMusicId], references: [id], onDelete: Cascade)
  backgroundMusicId Int             @default(1)
}

// Single row (id is always 1, like BackgroundMusic above) holding the
// site-wide "closed" switch. Reads go through lib/siteSettings.ts, which
// wraps this in Next's Data Cache with no time-based expiry — the table
// is only actually queried right after an admin flips the switch (the
// write calls revalidateTag), not on every visitor request. That keeps
// the shutdown check from adding any per-request database compute or
// network round trip.
model SiteSettings {
  id              Int      @id @default(1)
  shutdown        Boolean  @default(false)
  shutdownMessage String   @default("we're taking a quick break. back soon.")
  updatedAt       DateTime @updatedAt
}

// Single row (id is always 1) holding the one live poll, if any. Editing
// the question/options (setPollQuestion in lib/pollServer.ts) wipes and
// recreates PollOption rows and bumps `revision` — that revision is what
// invalidates old vote cookies so people can vote again on a genuinely
// new poll instead of being permanently locked out from a prior one.
// `active` controls whether it's live anywhere at all (wall banner +
// shutdown screen + popup). `showOnShutdown` is the separate toggle for
// whether it also appears on the shutdown screen specifically — a poll
// can be active on the wall without ever showing during a shutdown.
// `pushVersion` only ever increments, on each "push" from the admin
// panel; clients compare it against the last version they dismissed
// (stored client-side) to decide whether to pop the poll up again.
model Poll {
  id             Int          @id @default(1)
  question       String       @default("")
  active         Boolean      @default(false)
  showOnShutdown Boolean      @default(false)
  revision       Int          @default(1)
  pushVersion    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  options        PollOption[]
}

model PollOption {
  id        Int      @id @default(autoincrement())
  text      String
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    Int
}

// One row per active browser session, used only to answer "how many
// people are on the site right now". Each open tab pings /api/presence
// every ~20s to bump lastSeen; a session counts as "live" while lastSeen
// is recent (see PRESENCE_WINDOW_MS in lib/presence.ts). Rows are deleted
// as soon as a tab closes (best-effort beacon) or, failing that, once
// they go stale — so this table never accumulates history and is not a
// visit log (Visit above already covers total visits).
model Presence {
  sessionKey String   @id
  lastSeen   DateTime @default(now())
}

// Admin-added extra words to block, on top of the built-in default list in
// lib/wordFilter.ts. Kept separate from the defaults so the safety-net
// words are never accidentally deleted from the admin UI — this table is
// purely the "extra words you typed in yourself" list.
model BannedWord {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  createdAt DateTime @default(now())
}
