DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."
ADMIN_PASSWORD="pick-a-password"
ADMIN_SECRET="run: openssl rand -hex 32"

# Optional. Powers the "attach a gif" picker on /confess. Works out of the
# box using Giphy's public demo key, but that key is shared across the
# whole internet and gets rate-limited. Set one of the keys below for
# reliable results — priority if more than one is set: Klipy > Tenor > Giphy.

# Get a free lifetime key at https://partner.klipy.com — no rate-limit
# headaches, and it's what Discord/WhatsApp/Bluesky have been migrating to.
NEXT_PUBLIC_KLIPY_API_KEY=""

# Get a free key at https://developers.google.com/tenor/guides/quickstart
NEXT_PUBLIC_TENOR_API_KEY=""

# Get a free key at https://developers.giphy.com
NEXT_PUBLIC_GIPHY_API_KEY=""
