DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."
ADMIN_PASSWORD="pick-a-password"
ADMIN_SECRET="run: openssl rand -hex 32"

# Optional. Powers the "attach a gif" picker on /confess. Works out of the
# box using Giphy's public demo key. Set your own key for real traffic, or
# leave GIPHY blank and set TENOR instead to use Tenor as the provider —
# whichever is configured wins (Tenor takes priority if both are set).

# Get a free key at https://developers.giphy.com
NEXT_PUBLIC_GIPHY_API_KEY=""

# Get a free key at https://developers.google.com/tenor/guides/quickstart
# (Google Cloud Console — usually more reliable to sign up for than Giphy's
# own dashboard). If this is set, the picker switches to Tenor entirely.
NEXT_PUBLIC_TENOR_API_KEY=""
